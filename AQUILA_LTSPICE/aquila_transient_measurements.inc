* Pulse-window quantities include the Blackman envelope if WIN=1.
.meas TRAN VLOAD_MAX MAX V(V_LOAD) FROM {TSTART} TO {TSTART+TPULSE}
.meas TRAN VLOAD_MIN MIN V(V_LOAD) FROM {TSTART} TO {TSTART+TPULSE}
.meas TRAN VLOAD_PP PP V(V_LOAD) FROM {TSTART} TO {TSTART+TPULSE}
.meas TRAN VLOAD_RMS RMS V(V_LOAD) FROM {TSTART} TO {TSTART+TPULSE}
.meas TRAN VDAC_PP PP V(VIN_DAC) FROM {TSTART} TO {TSTART+TPULSE}
.meas TRAN ILOAD_RMS RMS I(VLOAD_SENSE) FROM {TSTART} TO {TSTART+TPULSE}
.meas TRAN ILOAD_MAX MAX I(VLOAD_SENSE) FROM {TSTART} TO {TSTART+TPULSE}
.meas TRAN ILOAD_MIN MIN I(VLOAD_SENSE) FROM {TSTART} TO {TSTART+TPULSE}
.meas TRAN PLOAD_AVG AVG V(P_LOAD_W) FROM {TSTART} TO {TSTART+TPULSE}
.meas TRAN PLOAD_RECORD AVG V(P_LOAD_W) FROM 0 TO {TSTOP}
.meas TRAN GAIN_PP PARAM VLOAD_PP/VDAC_PP
.meas TRAN VAMP_PP PP V(V_AMP) FROM {TSTART} TO {TSTART+TPULSE}
.meas TRAN RAIL_HEADROOM_MIN MIN V(HEADROOM_V) FROM {TSTART} TO {TSTART+TPULSE}
.meas TRAN SLEW_POS MAX V(SLEW_V_PER_US) FROM {TSTART} TO {TSTART+TPULSE}
